@page "/relatorios"

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Relatórios</MudText>
    <MudText Color="Color.Secondary">Relatórios e indicadores do sistema.</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Alunos</MudText>
                <MudText Typo="Typo.h4">1.248</MudText>
                <MudText Color="Color.Secondary">matriculados</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Professores</MudText>
                <MudText Typo="Typo.h4">86</MudText>
                <MudText Color="Color.Secondary">no corpo docente</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Cursos</MudText>
                <MudText Typo="Typo.h4">24</MudText>
                <MudText Color="Color.Secondary">cursos ativos</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Aprovação</MudText>
                <MudText Typo="Typo.h4" Color="Color.Success">91%</MudText>
                <MudText Color="Color.Secondary">média institucional</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-5">
        <MudText Typo="Typo.h6">Relatórios disponíveis</MudText>

        <MudStack Spacing="2">
            <MudPaper Class="pa-3">
                <MudText>📚 Relatório de alunos matriculados</MudText>
            </MudPaper>

            <MudPaper Class="pa-3">
                <MudText>👥 Relatório do corpo docente</MudText>
            </MudPaper>

            <MudPaper Class="pa-3">
                <MudText>📊 Relatório de desempenho acadêmico</MudText>
            </MudPaper>

            <MudPaper Class="pa-3">
                <MudText>📖 Relatório de cursos</MudText>
            </MudPaper>
        </MudStack>
    </MudPaper>
</MudStack>
