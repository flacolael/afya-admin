<MudCard Elevation="1" Class="pa-4 h-100">
    <MudStack Spacing="1">

        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Titulo
        </MudText>

        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @Valor
        </MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                     Color="Color.Success"
                     Size="Size.Small" />

            <MudText Typo="Typo.caption" Color="Color.Success">
                @Variacao
            </MudText>

            <MudText Typo="Typo.caption">
                vs. período anterior
            </MudText>
        </MudStack>

        <MudChart ChartType="ChartType.Line"
                  ChartSeries="@Series"
                  ChartLabels="@Labels"
                  Width="100%"
                  Height="55px" />

    </MudStack>
</MudCard>

@code {
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public string Variacao { get; set; } = string.Empty;
    [Parameter] public double[] Tendencia { get; set; } = [];

    private string[] Labels = ["", "", "", "", "", "", "", ""];

    private List<ChartSeries<double>> Series => new()
    {
        new()
        {
            Name = Titulo,
            Data = Tendencia
        }
    };
}
