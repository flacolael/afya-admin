@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Color="Color.Default">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-2">
            Afya Pedagógico
        </MudText>

        <MudText Typo="Typo.body2" Class="ml-4">
            / Dashboard
        </MudText>

        <MudSpacer />

        <MudTextField T="string"
                      Placeholder="Buscar..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mr-3"
                      Immediate="true" />

        <MudIconButton Icon="@(_isDarkMode
                                  ? Icons.Material.Filled.LightMode
                                  : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleDarkMode" />

        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                       Color="Color.Inherit" />

        <MudAvatar Color="Color.Primary" Class="ml-2">
            LV
        </MudAvatar>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Elevation="1">

        <MudDrawerHeader>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2"
                      Class="pa-4">

                <MudAvatar Color="Color.Primary">
                    A
                </MudAvatar>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">
                        Afya
                    </MudText>

                    <MudText Typo="Typo.caption">
                        Pedagógico
                    </MudText>
                </MudStack>

            </MudStack>

        </MudDrawerHeader>

        <NavMenu />

    </MudDrawer>

    <MudMainContent>

        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pa-md-6">
            @Body
        </MudContainer>

    </MudMainContent>

</MudLayout>

@code {

    private bool _drawerOpen = true;

    private bool _isDarkMode;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#594AE2",
            Secondary = "#FF4081"
        },

        PaletteDark = new PaletteDark
        {
            Primary = "#7C6FF2",
            Secondary = "#FF4081"
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }
}
